{
  "name": "@vx-daniel/pi-switchboard",
  "version": "0.4.0",
  "description": "OpenAI-compatible HTTP API over pi's models, logins and providers",
  "keywords": [
    "gateway",
    "llm",
    "openai",
    "pi-coding-agent",
    "pi-package",
    "proxy"
  ],
  "license": "MIT",
  "author": "Daniel Zenner",
  "contributors": [
    "Victor Araújo (original pi-openai-proxy, https://github.com/victor-software-house/pi-openai-proxy)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vx-daniel/pi-switchboard.git"
  },
  "bin": {
    "pi-switchboard": "dist/index.mjs"
  },
  "files": [
    "dist",
    "extensions"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./config": {
      "import": "./dist/config.mjs",
      "types": "./dist/config.d.mts"
    },
    "./exposure": {
      "import": "./dist/exposure.mjs",
      "types": "./dist/exposure.d.mts"
    },
    "./logging": {
      "import": "./dist/logging.mjs",
      "types": "./dist/logging.d.mts"
    },
    "./sync/zed": {
      "import": "./dist/sync-zed.mjs",
      "types": "./dist/sync-zed.d.mts"
    }
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vp pack --watch --on-success \"node dist/index.mjs --port ${PI_SWITCHBOARD_DEV_PORT:-4142}\"",
    "start": "node dist/index.mjs",
    "check:all": "node scripts/gate.ts",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "test:ci": "vp test --project offline --coverage",
    "fallow": "fallow --coverage coverage/coverage-final.json --fail-on-issues",
    "test:live": "PI_SWITCHBOARD_LIVE_TESTS=1 vp test --project live",
    "test:live:record": "node scripts/record-fixtures.ts",
    "openai-spec:update": "node scripts/update-openai-spec.ts",
    "build": "vp pack",
    "build:binary": "node scripts/build-binary.ts",
    "test:binary": "node scripts/build-binary.ts && PI_SWITCHBOARD_BINARY_TESTS=1 vp test --project binary",
    "smoke": "node dist/index.mjs --version",
    "prepare": "vp config --no-agent && vp pack",
    "prepack": "vp pack",
    "prepublishOnly": "vp test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/swagger-ui": "^0.6.1",
    "@logtape/file": "^2.4.1",
    "@logtape/logtape": "^2.4.1",
    "@logtape/pretty": "^2.4.1",
    "@logtape/redaction": "^2.4.1",
    "citty": "^0.2.2",
    "hono": "^4.12.18",
    "hono-openapi": "^1.5.0",
    "jsonc-parser": "^3.3.1",
    "minimatch": "^10.2.6",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@limegrass/eslint-plugin-import-alias": "^1.6.1",
    "@logtape/lint": "^2.4.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "catalog:",
    "ajv": "^8.20.0",
    "eslint-plugin-zod": "^3.12.0",
    "fallow": "3.34.1",
    "openai": "^6.36.0",
    "semantic-release": "^25.0.3",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "optionalDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.1.1",
  "pi": {
    "extensions": [
      "./extensions"
    ]
  }
}
